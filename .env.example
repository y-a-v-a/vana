# Copy to .env and fill in. .env is gitignored.

# Generator — Anthropic (Claude Opus). Already present in this Mac Mini's env.
ANTHROPIC_API_KEY=sk-ant-...

# Jury — OpenRouter. REQUIRED before first run; the jury cannot grade without it.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Email notifications — authenticated SMTP from the agent mailbox.
# Use a secure SMTPS port (465). STARTTLS/587 is not supported.
SMTP_HOST=smtp.your-provider.tld
SMTP_PORT=465
SMTP_USER=agent@vincentbruijn.nl
SMTP_PASS=...
# Optional; defaults to SMTP_USER:
SMTP_FROM=agent@vincentbruijn.nl
