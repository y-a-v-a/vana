# Copy to ~/.config/vana/secrets.env (chmod 600) and fill in. That file is loaded
# with override, so it wins over anything exported by .zshenv. A repo-local .env
# (gitignored) is also read, at lower precedence. VANA_SECRETS_FILE overrides the path.

# Generator — first-party Anthropic API (Claude Opus via the Agent SDK). A key
# dedicated to Vana; the generator never falls back to a global ANTHROPIC_API_KEY,
# and strips ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN so it can't be routed elsewhere.
VANA_ANTHROPIC_API_KEY=sk-ant-...

# Jury — OpenRouter. REQUIRED before first run; the jury cannot grade without it.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Email notifications — authenticated SMTP from the agent mailbox.
# Implicit TLS on port 465 (SMTPS). STARTTLS/587 is not supported.
ONI_MAIL_SERVER=smtp.your-provider.tld
ONI_MAIL_ADDRESS=agent@vincentbruijn.nl
ONI_MAIL_PASSWORD=...
# Optional:
ONI_MAIL_PORT=465
ONI_MAIL_FROM=agent@vincentbruijn.nl
