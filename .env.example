# Copy to .env and fill in. .env is gitignored.

# Generator — Anthropic (Claude Opus). Already present in this Mac Mini's env.
ANTHROPIC_API_KEY=sk-ant-...

# Jury — OpenRouter. REQUIRED before first run; the jury cannot grade without it.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Email notifications — authenticated SMTP from the agent mailbox.
# Implicit TLS on port 465 (SMTPS). STARTTLS/587 is not supported.
ONI_MAIL_SERVER=smtp.your-provider.tld
ONI_MAIL_ADDRESS=agent@vincentbruijn.nl
ONI_MAIL_PASSWORD=...
# Optional:
ONI_MAIL_PORT=465
ONI_MAIL_FROM=agent@vincentbruijn.nl
